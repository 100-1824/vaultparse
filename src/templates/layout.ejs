<!DOCTYPE html>
<html lang="<%= brand.language %>" class="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta http-equiv="Content-Security-Policy" content="<%= csp %>">
  <title><%= page.title %></title>
  <meta name="description" content="<%= page.description %>">
  <link rel="canonical" href="<%= page.canonical %>">
  <meta name="robots" content="<%= page.noindex ? 'noindex,follow' : 'index,follow,max-snippet:-1' %>">
  <meta name="referrer" content="no-referrer">
  <meta name="color-scheme" content="dark light">
  <meta name="theme-color" content="<%= brand.themeColorDark %>">
  <meta name="application-name" content="<%= brand.name %>">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="<%= brand.name %>">
  <meta property="og:title" content="<%= page.ogTitle || page.title %>">
  <meta property="og:description" content="<%= page.description %>">
  <meta property="og:url" content="<%= page.canonical %>">
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="<%= page.ogTitle || page.title %>">
  <meta name="twitter:description" content="<%= page.description %>">
  <link rel="icon" type="image/svg+xml" href="<%= root %>favicon.svg">
  <link rel="sitemap" type="application/xml" href="<%= root %>sitemap.xml">
<% if (hasApp) { %>
  <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
<% } %>
  <script><%- themeScript %></script>
  <link rel="stylesheet" href="<%= root %>css/tailwind.css?v=<%= buildId %>">
  <link rel="stylesheet" href="<%= root %>css/custom.css?v=<%= buildId %>">
<% jsonLd.forEach(function (block) { %>
  <script type="application/ld+json"><%- safeJson(block) %></script>
<% }); %>
</head>
<body class="min-h-screen antialiased">
  <a href="#main" class="vp-skip">Skip to converter</a>

  <header class="vp-chrome vp-header">
    <div class="mx-auto flex max-w-6xl items-center gap-3 px-4 py-3">
      <a href="<%= root %>index.html" class="vp-logo" aria-label="<%= brand.name %> home">
        <svg viewBox="0 0 32 32" width="26" height="26" aria-hidden="true"><rect x="2" y="2" width="28" height="28" rx="7" fill="none" stroke="currentColor" stroke-width="2.4"/><path d="M9 11l7 11 7-11" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span><%= brand.name %></span>
      </a>
      <nav class="ml-auto flex items-center gap-1 sm:gap-2" aria-label="Primary">
        <a href="<%= root %>directory.html" class="vp-nav-link">All converters</a>
<% if (hasApp) { %>
        <button type="button" class="vp-nav-link vp-hide-sm" data-open="embed">&lt;/&gt; Embed</button>
        <button type="button" class="vp-btn vp-btn-accent vp-btn-sm" data-open="pro"><span data-pro-label>Unlock Pro</span></button>
<% } else { %>
        <a href="<%= root %>index.html" class="vp-btn vp-btn-accent vp-btn-sm">Open converter</a>
<% } %>
        <button type="button" id="theme-toggle" class="vp-icon-btn" aria-label="Switch between dark and light theme" title="Toggle theme">
          <svg class="vp-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="2"/><path d="M12 2.5v2.6M12 18.9v2.6M2.5 12h2.6M18.9 12h2.6M5.3 5.3l1.8 1.8M16.9 16.9l1.8 1.8M5.3 18.7l1.8-1.8M16.9 7.1l1.8-1.8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          <svg class="vp-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M20 14.2A8.2 8.2 0 0 1 9.8 4a8.2 8.2 0 1 0 10.2 10.2z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
        </button>
      </nav>
    </div>
  </header>

  <main id="main">
<%- body %>
  </main>

  <footer class="vp-chrome vp-footer">
    <div class="mx-auto grid max-w-6xl gap-6 px-4 py-10 sm:grid-cols-[1.4fr_1fr_1fr]">
      <div>
        <p class="vp-logo"><span><%= brand.name %></span></p>
        <p class="mt-2 max-w-sm text-sm vp-muted"><%= brand.shortDescription %></p>
      </div>
      <div>
        <p class="vp-footer-title">Converters</p>
        <ul class="vp-footer-list">
<% clusters.forEach(function (cluster) { %>
          <li><a href="<%= root %>directory.html#<%= cluster.id %>"><%= cluster.title %></a></li>
<% }); %>
        </ul>
      </div>
      <div>
        <p class="vp-footer-title">Product</p>
        <ul class="vp-footer-list">
          <li><a href="<%= root %>index.html">PDF converter</a></li>
          <li><a href="<%= root %>directory.html">All <%= pageCount %> converters</a></li>
          <li><a href="<%= root %>index.html?demo=1">Try the sample documents</a></li>
          <li><a href="<%= root %>sitemap.xml">Sitemap</a></li>
        </ul>
      </div>
    </div>
    <div class="mx-auto max-w-6xl px-4 pb-8 text-xs vp-muted">
      <p>&copy; <%= year %> <%= brand.name %>. Documents are parsed inside your browser tab; nothing is uploaded, stored or logged.</p>
<% if (page.disclaimer) { %>
      <p class="mt-1"><%= page.disclaimer %></p>
<% } %>
      <p class="mt-1">Extraction is rule-based. Always review the grid against the original document before filing or importing.</p>
    </div>
  </footer>

  <p class="vp-embed-credit">Powered by <a href="<%= siteUrl %>/" target="_blank" rel="noopener"><%= brand.name %></a> &mdash; private, in-browser PDF to CSV conversion.</p>

  <div id="toast" class="vp-toast" role="status" aria-live="polite"></div>
<% if (hasApp) { %>
  <script id="vp-config" type="application/json"><%- safeJson(clientConfig) %></script>
  <script defer src="<%= cdn.pdfjs.src %>" integrity="<%= cdn.pdfjs.integrity %>" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
  <script defer src="<%= cdn.papaparse.src %>" integrity="<%= cdn.papaparse.integrity %>" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
  <script defer src="<%= root %>js/pdf_engine.js?v=<%= buildId %>"></script>
  <script defer src="<%= root %>js/parser_rules.js?v=<%= buildId %>"></script>
  <script defer src="<%= root %>js/exporter.js?v=<%= buildId %>"></script>
  <script defer src="<%= root %>js/app.js?v=<%= buildId %>"></script>
<% } %>
</body>
</html>
